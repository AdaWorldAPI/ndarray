@prefix ogit:           <http://www.purl.org/ogit/> .
@prefix ogit.Cognitive: <http://www.purl.org/ogit/Cognitive/> .
@prefix rdf:            <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
